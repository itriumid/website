/**
 * Deploys to Cloudflare Workers. Every page is prerendered, so the Worker only serves static
 * files. https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "itrium-website",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-09-26",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Creates the DNS record for itrium.id itself. www.itrium.id is redirected to it by a
	// Cloudflare redirect rule, not here: static files are served before the Worker runs.
	"routes": [{ "pattern": "itrium.id", "custom_domain": true }],
	// No logs of visitors' requests are kept.
	"observability": { "enabled": false }
}
